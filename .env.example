# ADEPT Fragrances — Website
# Copy to .env and replace with real values. Never commit real credentials.

# Database (PostgreSQL) — required
DATABASE_URL="postgresql://adept:adept@localhost:5432/adept_website?schema=public"

# Public site URL for canonicals / sitemap / Open Graph
# Local: http://localhost:3000 | Staging: your staging URL | Prod: https://www.adeptfragrances.com
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Proposed public domain (ownership not assumed until COMPANY_DOMAIN_VERIFIED=true)
COMPANY_DOMAIN="https://www.adeptfragrances.com"
COMPANY_DOMAIN_VERIFIED="false"

# Company contact — single official mailbox for all business purposes
COMPANY_EMAIL="info@adeptfragrances.com"
# Retained for notification-code compatibility; must match COMPANY_EMAIL
SALES_EMAIL="info@adeptfragrances.com"
# Leave telephone/WhatsApp unset or placeholder until verified (UI hides placeholders)
COMPANY_TELEPHONE=""
COMPANY_WHATSAPP=""

# Legal name (proposed) — keep VERIFIED=false until confirmed
COMPANY_LEGAL_NAME="Adept Fragrance Industries (Private) Limited"
COMPANY_LEGAL_NAME_VERIFIED="false"

# Address — leave empty until verified
COMPANY_ADDRESS=""
COMPANY_ADDRESS_VERIFIED="false"

# Social (optional)
SOCIAL_LINKEDIN=""
SOCIAL_INSTAGRAM=""

# Rate-limit IP hashing salt (use a long random string in staging/production)
IP_HASH_SALT="replace-with-long-random-string"

# SMTP — if empty, email notifications are BLOCKED (inquiries still save to DB)
# See docs/INQUIRY_RETRIEVAL.md
# SMTP_FROM should be info@adeptfragrances.com once the provider authorizes sending as that address.
# SMTP_USER may differ from SMTP_FROM (authentication identity ≠ From header).
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="info@adeptfragrances.com"

# ERP integration (leave empty until authorized API is available) — NOT CONNECTED
ERP_API_URL=""
ERP_API_KEY=""

# OpenAI — website ADEPT Assistant (optional)
# ChatGPT Plus/Pro does NOT include API credits. Create a key at platform.openai.com
# and add billing/spend limits there before enabling.
# OPENAI_API_KEY="sk-..."
# Explicit paid-usage gate (required). Leave false/unset to keep FAQ-only mode.
OPENAI_CHAT_ENABLED="false"
# Optional model override (default: gpt-4o-mini)
# OPENAI_CHAT_MODEL="gpt-4o-mini"
