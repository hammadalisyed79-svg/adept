# ADEPT Fragrance Industries — Website
# Copy to .env and replace with real values. Never commit real credentials.

# Database (PostgreSQL)
DATABASE_URL="postgresql://adept:adept@localhost:5432/adept_website?schema=public"

# Public site URL (used for canonical URLs, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL="https://www.adeptfragrance.example"

# Company contact (override defaults in src/lib/company.ts)
COMPANY_EMAIL="inquiries@adeptfragrance.example"
SALES_EMAIL="sales@adeptfragrance.example"
COMPANY_TELEPHONE="+00 000 000 0000"
COMPANY_WHATSAPP="+000000000000"
COMPANY_DOMAIN="https://www.adeptfragrance.example"

# Address — leave empty until verified; set COMPANY_ADDRESS_VERIFIED=true only when confirmed
COMPANY_ADDRESS=""
COMPANY_ADDRESS_VERIFIED="false"

# Social (optional)
SOCIAL_LINKEDIN=""
SOCIAL_INSTAGRAM=""

# Rate-limit IP hashing salt (use a long random string in production)
IP_HASH_SALT="replace-with-long-random-string"

# SMTP (optional — inquiries still save if mail is unconfigured)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""

# ERP integration (leave empty until authorized API is available)
ERP_API_URL=""
ERP_API_KEY=""
